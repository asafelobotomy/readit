{
  "name": "readit",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "extension"
  ],
  "scripts": {
    "dev": "npm run dev -w @readit/extension",
    "build": "npm run build -w @readit/extension",
    "compile": "npm run compile -w @readit/extension",
    "zip": "npm run zip -w @readit/extension",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:versions": "node scripts/check-versions.mjs",
    "version:set": "npm version --workspaces --include-workspace-root --no-git-tag-version",
    "test": "npm run test:layout && npm run test:hardening",
    "test:layout": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs scripts/test-layout-slots.mts",
    "test:hardening": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs scripts/test-hardening.mts",
    "smoke": "npm run build && node scripts/smoke-reddit.mjs",
    "smoke:brave": "READIT_CDP=http://127.0.0.1:9222 node scripts/smoke-reddit.mjs",
    "smoke:layout": "npm run build && node scripts/smoke-layout.mjs",
    "smoke:layout:brave": "npm run build && READIT_CDP=http://127.0.0.1:9222 node scripts/smoke-layout.mjs",
    "smoke:edit": "npm run build && node scripts/smoke-edit.mjs",
    "smoke:edit:brave": "npm run build && READIT_CDP=http://127.0.0.1:9222 node scripts/smoke-edit.mjs",
    "smoke:nav": "npm run build && node scripts/smoke-nav.mjs",
    "smoke:nav:brave": "READIT_CDP=http://127.0.0.1:9222 node scripts/smoke-nav.mjs",
    "smoke:visual": "node --experimental-strip-types --import ./scripts/register-ts-resolve.mjs scripts/smoke-visual.mts"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {},
  "devDependencies": {
    "playwright": "^1.62.1",
    "puppeteer-core": "^25.9.0"
  }
}
